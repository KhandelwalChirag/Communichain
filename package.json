{
  "name": "communichain",
  "version": "1.0.0",
  "description": "Agent communication system using Hedera Consensus Service",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev:ui": "vite",
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:ui\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node src/index.js",
    "dev:server": "tsx watch src/index.js",
    "lint": "eslint src --ext js,jsx,ts,tsx",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md}\"",
    "typecheck": "tsc --noEmit",
    "kill-port": "node scripts/kill-port.js",
    "prepare": "node scripts/deploy.js"
  },
  "dependencies": {
    "@hashgraph/sdk": "^2.26.0",
    "@headlessui/react": "^1.7.14",
    "@heroicons/react": "^2.2.0",
    "@langchain/core": "^0.1.18",
    "@langchain/google-genai": "^0.0.10",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "axios": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "framer-motion": "^12.9.2",
    "jsonwebtoken": "^9.0.0",
    "langchain": "^0.1.21",
    "natural": "^6.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.11.1",
    "vite": "^6.3.4",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.87",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.1",
    "@typescript-eslint/eslint-plugin": "^5.59.2",
    "@typescript-eslint/parser": "^5.59.2",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "eslint": "^8.39.0",
    "eslint-plugin-react": "^7.32.2",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.3",
    "prettier": "^2.8.8",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "@types/natural": "^5.1.5"
  }
}
